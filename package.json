{
  "name": "hvl",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=true next dev",
    "build": "BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=true next build",
    "start": "next start",
    "lint": "eslint",
    "electron:start": "electron .",
    "dist:portable": "electron-builder --win portable",
    "dist:installer": "electron-builder --win nsis",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.hvl.album",
    "productName": "HVL Album",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "out/**/*",
      "public/images/app-icon.ico"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/images/app-icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-Portable.exe"
    }
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.2",
    "next": "16.3.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.11.13",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "typescript": "^5"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "resolutions": {
    "baseline-browser-mapping": "^2.11.13"
  }
}
